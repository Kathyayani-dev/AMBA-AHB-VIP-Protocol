class mstr_drv extends uvm_driver#(ahb_xtn);
	`uvm_component_utils(mstr_drv)
	
	virtual ahb_if.MSTR_DRV_MP vif;
	mstr_agt_cfg m_cfg;

	int mstr_drv_cnt;

	function new(string name="mstr_drv", uvm_component parent);
		super.new(name,parent);
	endfunction

	function void build_phase(uvm_phase phase);
		if(!uvm_config_db#(mstr_agt_cfg)::get(this,"","mstr_agt_cfg",m_cfg))
			`uvm_fatal("IN MSTR DRV", "getting failed")
	endfunction

	function void connect_phase(uvm_phase phase);
		vif=m_cfg.vif;
	endfunction

	task run_phase(uvm_phase phase);  

		@(vif.mstr_drv_cb)
		vif.mstr_drv_cb.HRESETn <= 0;
		@(vif.mstr_drv_cb)
		vif.mstr_drv_cb.HRESETn <= 1;

		forever
		begin
		//	$display("11111");
			seq_item_port.get_next_item(req);
		//	req.print();
			send_to_dut(req);
			seq_item_port.item_done();
		end
	endtask
	
	task send_to_dut(ahb_xtn req);
		vif.mstr_drv_cb.HADDR<=req.HADDR;
		vif.mstr_drv_cb.HTRANS<=req.HTRANS;
		vif.mstr_drv_cb.HSIZE<=req.HSIZE;
		vif.mstr_drv_cb.HBURST<=req.HBURST;
		vif.mstr_drv_cb.HWRITE<=req.HWRITE;
		//req.sprint();

		@(vif.mstr_drv_cb)
		wait(vif.mstr_drv_cb.HREADY);
		if(req.HWRITE)
			begin
			vif.mstr_drv_cb.HWDATA<=req.HWDATA;
			end
		else
			begin
			vif.mstr_drv_cb.HWDATA<=0;
			req.HRDATA=vif.mstr_drv_cb.HRDATA;
			end

		mstr_drv_cnt++;
		$display("Mstr Driver count: %0d",mstr_drv_cnt);

		`uvm_info("mstr_drv",req.sprint(),UVM_LOW)


	endtask
endclass
