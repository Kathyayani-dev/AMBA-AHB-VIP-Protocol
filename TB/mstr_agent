class mstr_seqs extends uvm_sequence#(ahb_xtn);
	`uvm_object_utils(mstr_seqs)
	
	function new(string name="mstr_seqs");
		super.new(name);
	endfunction
endclass

class single_seqs extends mstr_seqs;
	`uvm_object_utils(single_seqs)
	
	function new(string name="single_seqs");
		super.new(name);
	endfunction
	
	task body();
		req=ahb_xtn::type_id::create("req");

		start_item(req);
		assert(req.randomize() with {HBURST==0; HTRANS==2;});  //non-seq
		uvm_config_db #(bit[9:0])::set(null,"*","length",req.length);
		finish_item(req);

		//uvm_config_db#(bit[9:0])::set(null,"*","length",req.length);
		start_item(req);
		assert(req.randomize() with {HBURST==0; HTRANS==0;});  //idle
		finish_item(req);
	endtask
endclass

class incr_seqs extends mstr_seqs;
	`uvm_object_utils(incr_seqs)
	
	function new(string name="incr_seqs");
		super.new(name);
	endfunction

	bit[31:0]haddr;
	bit [2:0]hburst, hsize;
	bit hwrite;
	bit [9:0]length;

	task body();
		req=ahb_xtn::type_id::create("req");

		start_item(req);
		assert(req.randomize() with {HBURST inside {3,5,7};
					     HTRANS==2;}); //non-seq
		uvm_config_db #(bit[9:0])::set(null,"*","length",req.length);

		finish_item(req);

		haddr=req.HADDR;
		hburst=req.HBURST;
		hsize=req.HSIZE;
		hwrite=req.HWRITE;
		length=req.length;

		for(int i=0; i<length-1; i++)
		begin
			start_item(req);
			assert(req.randomize() with {HTRANS==3;  //seq
						     HADDR==haddr+(2**hsize);
						     HSIZE==hsize;
						     HBURST==hburst;
						     HWRITE==hwrite;});
			finish_item(req);
				haddr=req.HADDR;
		end

			start_item(req);
			assert(req.randomize() with {HTRANS==0;  //idle
						     HADDR==haddr+(2**hsize);
						     HSIZE==hsize;
						     HBURST==hburst;
						     HWRITE==hwrite;});
			finish_item(req);
	endtask
endclass
	
class wrap_seqs extends mstr_seqs;
	`uvm_object_utils(wrap_seqs)
	
	function new(string name="wrap_seqs");
		super.new(name);
	endfunction

	bit[31:0]haddr;
	bit [2:0]hburst, hsize;
	bit hwrite;
	bit [9:0]length;
	bit [31:0]SA, WB; //start addr , wrap boundary

	task body();
		req=ahb_xtn::type_id::create("req");

		start_item(req);
		assert(req.randomize() with {HBURST inside {2,4,6};
					     HTRANS==2;});  //non-seq
		uvm_config_db #(bit[9:0])::set(null,"*","length",req.length);

		finish_item(req);

	//	uvm_config_db#(bit[9:0])::set(null,"*","length",req.length);
		haddr=req.HADDR;
		hburst=req.HBURST;
		hsize=req.HSIZE;
		hwrite=req.HWRITE;
		length=req.length;

		SA=(haddr/((2**hsize)*length)) * ((2**hsize)*length);
		WB=SA+((2**hsize)*length);
		
		for(int i=0; i<length-1; i++)
		begin
			haddr=(2**hsize)+haddr;
			if(haddr==WB)
				haddr=SA;

			start_item(req);
			assert(req.randomize() with {HTRANS==3;  //seq
						     HADDR==haddr;
						     HSIZE==hsize;
						     HBURST==hburst;
						     HWRITE==hwrite;});
			finish_item(req);
				haddr=req.HADDR;
		end

			start_item(req);
			assert(req.randomize() with {HTRANS==0;  //idle
						     HADDR==haddr;
						     HSIZE==hsize;
						     HBURST==hburst;
						     HWRITE==hwrite;});
			finish_item(req);
	endtask
endclass
