class mstr_mon extends uvm_monitor;
	`uvm_component_utils(mstr_mon)
	
	virtual ahb_if.MSTR_MON_MP vif;
	mstr_agt_cfg m_cfg;
	uvm_analysis_port#(ahb_xtn) ap;
	ahb_xtn req;

	int mstr_mon_cnt;

	function new(string name="mstr_mon", uvm_component parent);
		super.new(name,parent);
		ap=new("ap",this);
		req=ahb_xtn::type_id::create("req");
	endfunction

	function void build_phase(uvm_phase phase);
			if(!uvm_config_db#(mstr_agt_cfg)::get(this,"","mstr_agt_cfg",m_cfg))
			`uvm_fatal("IN MSTR MON", "getting failed")
	endfunction

	function void connect_phase(uvm_phase phase);
		vif=m_cfg.vif;
	endfunction

	task run_phase(uvm_phase phase);
		forever
		begin
			collect_data();
		end
	endtask

	task collect_data();
		wait(vif.mstr_mon_cb.HTRANS==2'b10 || vif.mstr_mon_cb.HTRANS==2'b11)   //ready
			req.HADDR=vif.mstr_mon_cb.HADDR;
			req.HSIZE=vif.mstr_mon_cb.HSIZE;
			req.HBURST=vif.mstr_mon_cb.HBURST;
			req.HWRITE=vif.mstr_mon_cb.HWRITE;
			req.HTRANS=vif.mstr_mon_cb.HTRANS;
			req.HREADY=vif.mstr_mon_cb.HREADY;

		@(vif.mstr_mon_cb);
		wait(vif.mstr_mon_cb.HREADY)
		if(vif.mstr_mon_cb.HWRITE)
			req.HWDATA=vif.mstr_mon_cb.HWDATA;
		else
			req.HRDATA=vif.mstr_mon_cb.HRDATA;

	mstr_mon_cnt++;
        $display("Mstr Monitor count: %0d",mstr_mon_cnt);

	`uvm_info("mstr_mon",req.sprint(),UVM_LOW)
	ap.write(req);
	endtask
	
endclass
